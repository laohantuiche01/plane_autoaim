source install/setup.sh

# ============================================================
# jemalloc 自动检测（跨平台，无依赖脚本）
# ============================================================
# 自动查找 jemalloc 库，支持不同安装路径
ARCH=$(uname -m)
case "$ARCH" in
    x86_64)
        JEMALLOC_PATHS=(
            "/usr/lib/x86_64-linux-gnu/libjemalloc.so.2"
            "/usr/local/lib/libjemalloc.so.2"
            "/opt/jemalloc/lib/libjemalloc.so.2"
        )
        ;;
    aarch64)
        JEMALLOC_PATHS=(
            "/usr/lib/aarch64-linux-gnu/libjemalloc.so.2"
            "/usr/local/lib/libjemalloc.so.2"
            "/opt/jemalloc/lib/libjemalloc.so.2"
        )
        ;;
    *)
        JEMALLOC_PATHS=(
            "/usr/lib/libjemalloc.so.2"
            "/usr/local/lib/libjemalloc.so.2"
            "/opt/jemalloc/lib/libjemalloc.so.2"
        )
        ;;
esac

# 查找第一个存在的 jemalloc 库
for JEMALLOC_PATH in "${JEMALLOC_PATHS[@]}"; do
    if [ -f "$JEMALLOC_PATH" ]; then
        export LD_PRELOAD="$JEMALLOC_PATH"
        break
    fi
done

# ============================================================
# ROS 2 工作空间设置
# ============================================================
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# 相对于项目根目录的 cyclonedds 配置
export CYCLONEDDS_URI="$(dirname "$BASH_SOURCE")/cyclonedds_shm.xml"

# --- For FastDDS SHM (uncomment to switch back) ---
# export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# export FASTRTPS_DEFAULT_PROFILES_FILE="$(dirname "$BASH_SOURCE")/fastdds_shm_profile.xml"

# ============================================================
# 性能优化
# ============================================================
export MALLOC_CONF="background_thread:true,metadata_thp:auto"
